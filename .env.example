# Aether Go Backend - Environment Configuration
# Copy this to .env and customize for your environment

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
ALLOWED_ORIGINS=*

# ===========================================
# Docker Configuration
# ===========================================
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_REGISTRY=us-docker.pkg.dev/android-emulator-268719/images

# ===========================================
# Emulator Configuration
# ===========================================
EMULATOR_ADDR=localhost:8554
ADB_KEY_PATH=/path/to/adbkey

# ===========================================
# WebRTC TURN Server Configuration
# Required for NAT traversal on cloud instances (GCP, AWS, etc.)
# ===========================================
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USER=dev
TURN_PASS=dev123

# ===========================================
# GPU Bridge Configuration
# ===========================================
# Set to 'false' to always use gRPC streaming (slower but works everywhere)
# Set to 'true' to try GPU bridge first (faster when GPU is available)
USE_GPU_BRIDGE=true

# ===========================================
# Stream Quality Settings (for gRPC streaming fallback)
# ===========================================
# Resolution to request from emulator (smaller = less data to transfer)
STREAM_WIDTH=720
STREAM_HEIGHT=1280

# ===========================================
# Performance Tuning for Cloud VMs
# ===========================================
# The system auto-detects GPU availability and adjusts settings:
# - With GPU: Uses NVENC/VAAPI hardware encoding, 30fps, high quality
# - Without GPU: Uses x264 software encoding, 20fps, optimized for CPU
#
# These settings are used when no GPU is detected:
# - FPS is capped at 20 to reduce CPU load
# - Resolution defaults to 720x1280 (downscaled by emulator)
# - Bitrate capped at 1500kbps for consistent streaming
# - x264 preset: superfast (good quality/speed balance)

# ===========================================
# Database Configuration (optional)
# ===========================================
# DATABASE_URL=postgres://user:pass@host:5432/aether

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-secret-key-here

